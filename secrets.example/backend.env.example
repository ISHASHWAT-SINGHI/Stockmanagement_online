# Copy to secrets/backend.env (git-ignored) and fill in real values.
# On Render/other hosts, set the same names as environment variables instead.

# PostgreSQL connection string from the Supabase dashboard (Connect → Session pooler, port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Optional: tried before DATABASE_URL at startup.
# DATABASE_FALLBACK_URL=

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Seeded admin account, created only when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional
# LOG_LEVEL=INFO
# DB_CONNECT_RETRIES=3
# DB_CONNECT_RETRY_DELAY_SECONDS=2
